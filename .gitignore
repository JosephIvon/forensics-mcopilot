# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 打包产物（`pip wheel .` / `python -m build` 的中间物与 wheel）
# 不入库：它们是**本机的构建残留**，不是交付物；入仓只会在每次构建后平白多出
# 几十个重复文件，还会让"这个文件是谁改的"永远说不清。
build/
dist/
*.whl

# 生成的产出物（可复现，不入库）
# 但交叉验证的元数据是**证据**，要留着
out/*
!out/crossval_export10_meta.json

# 测试用的临时目录（架构契约测试自建，不入库）
.test_tmp/

# 运行日志
*.log
# **但样例日志是测试夹具，必须入库**（2026-10-23 干净克隆实测：
#   `*.log` 把 samples/logs/*.log 一起扫掉 → 公开克隆里 14 个测试因缺夹具而红 ✗）
!samples/logs/*.log

# 本地环境
.venv/
venv/
.env

# 编辑器
.vscode/
.idea/
*.swp
